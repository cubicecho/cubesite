<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} · {{ site.name }}{% else %}{{ site.name }} — {{ site.tagline }}{% endif %}</title>
    <meta name="description" content="{{ description or site.description }}" />
    <meta property="og:title" content="{{ title or site.name }}" />
    <meta property="og:description" content="{{ description or site.description }}" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ site.url }}" />
    <link rel="icon" type="image/svg+xml" href="{{ '/assets/favicon.svg' | url }}" />
    <link rel="stylesheet" href="{{ '/css/cubesite.css' | url }}" />
    <link rel="stylesheet" href="{{ '/css/site.css' | url }}" />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="{{ '/' | url }}">
        {% include "mark.njk" %}
        <span class="name">{{ site.name }}</span>
      </a>
      <nav>
        <a href="{{ '/' | url }}"{% if page.url == ('/' | url) %} aria-current="page"{% endif %}>Home</a>
        <a href="{{ '/adopt/' | url }}"{% if page.url == ('/adopt/' | url) %} aria-current="page"{% endif %}>Adopt it</a>
        <a href="{{ '/brand/' | url }}"{% if page.url == ('/brand/' | url) %} aria-current="page"{% endif %}>Brand</a>
        <a href="{{ site.repo }}" rel="noopener">GitHub ↗</a>
        <a href="{{ site.org }}" rel="noopener">Cubic Echo ↗</a>
      </nav>
    </header>

    <main>
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <span>© {% year %} Cubic Echo</span>
      <span class="footer-links">
        <a href="{{ site.repo }}" rel="noopener">Source</a>
        <a href="{{ '/theme/cubesite.css' | url }}">cubesite.css</a>
        <a href="{{ site.org }}" rel="noopener">cubicecho.com</a>
      </span>
    </footer>
  </body>
</html>
